# Base URL of the BrathaMatu API. Leave as `/api` for local development and the
# normal same-origin deploy — `vite.config.ts` proxies `/api` and `/sanctum` to
# the Laravel server. Only set an absolute URL when the SPA is hosted apart from
# the API, and make sure that origin is in the backend's
# SANCTUM_STATEFUL_DOMAINS list. No secrets here: VITE_* is shipped to the browser.
VITE_API_BASE_URL=/api
